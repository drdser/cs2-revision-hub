{
  "name": "cs2-final-exam-revision-hub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "validate": "tsx scripts/validate-bank.ts",
    "check": "npm run validate && npm run test:merge && npm run lint && npm run build",
    "smoke": "tsx scripts/smoke-test.ts",
    "bundle": "tsx scripts/bundle-single-file.ts",
    "verify:single": "node scripts/verify-single.mjs",
    "test:merge": "tsx scripts/test-merge.ts",
    "sync:mock": "node scripts/mock-sync-server.mjs 4400",
    "test:sync": "node scripts/test-sync-e2e.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  },
  "description": "An open-source CS2 final exam revision hub: question bank, output tracing, exam predictions and a mock final for Chapters 9-15.",
  "license": "MIT",
  "keywords": [
    "cs2",
    "java",
    "revision",
    "exam",
    "inheritance",
    "polymorphism",
    "exceptions",
    "file-io",
    "education"
  ]
}
